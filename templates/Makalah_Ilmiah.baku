  "content": [
    {
      "insert": "PENERAPAN METODOLOGI DOKUMEN DIGITAL TERSTANDARISASI PADA KARYA ILMIAH MAHASISWA",
      "attributes": {
        "bold": true,
        "size": "16pt",
        "font": "Times New Roman"
