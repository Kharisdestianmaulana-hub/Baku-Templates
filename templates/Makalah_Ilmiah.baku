    {
      "insert": "\n",
      "attributes": {
        "align": "center"
      }
    },
    {
      "insert": "Tinjauan Komparatif Efektivitas Penyusunan Makalah Kuliah dan Format Publikasi",
      "attributes": {
        "italic": true,
        "size": "12pt",
